# Prompt Pack Builder — environment variables
#
# Leave OPENAI_API_KEY unset to run entirely in DEMO MODE.
# In demo mode, /api/generate returns high-quality template-based
# prompt packs instead of calling a real model, and the UI shows a
# visible "DEMO MODE" badge. No requests ever leave the server
# unless a key is present.

# OpenAI API key. If set, generation calls the real OpenAI API
# through lib/ai/openai-provider.ts.
OPENAI_API_KEY=

# Model used for generation requests (only relevant when
# OPENAI_API_KEY is set).
OPENAI_MODEL=gpt-4o-mini
